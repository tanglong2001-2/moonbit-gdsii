///|
fn rename_expect_error(
  source : @gdsii.GdsLibrary,
  old : String,
  name : String,
  expected : Json,
) -> Unit raise {
  match source.rename_cell(old, name) {
    Ok(_) => fail("rename query should fail before producing a library")
    Err(error) => assert_eq(error.to_json(), expected)
  }
}

///|
test "cell rename complete independent stream and record positions" {
  let bytes = rename_fixture(0)
  let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
  let renamed = source.rename_cell("gate", "coreA").unwrap()
  assert_eq(renamed.to_bytes(), rename_fixture(3))
  assert_eq(source.to_bytes(), bytes)
  assert_eq(renamed.name(), "gate")
  assert_eq([ for cell in renamed.catalog().cells => cell.name ], [
    "coreA", "die", "probe",
  ])
  assert_eq(renamed.catalog().top_cells, ["die", "probe"])
  let mut count = 0
  for cell in renamed.catalog().cells {
    for reference in cell.references {
      assert_eq(reference.target, "coreA")
      assert_eq(reference.resolved, true)
      count += 1
    }
  }
  assert_eq(count, 3)
  let mut offset = 0
  for record in renamed.records() {
    assert_eq(record.offset, offset)
    offset += record.data.length() + 4
  }
  assert_eq(offset, renamed.to_bytes().length())
}

///|
test "cell rename existing-name no-op keeps physical padding" {
  let bytes = rename_fixture(0)
  let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
  assert_eq(
    source.rename_cell("gate", "gate").unwrap().to_bytes(),
    rename_fixture(4),
  )
  rename_expect_error(source, "absent", "absent", ["MissingCell", "absent"])
  assert_eq(source.to_bytes(), bytes)
}

///|
test "cell rename refuses collisions and unresolved destination capture" {
  let source = @gdsii.GdsLibrary::parse(rename_fixture(0)).unwrap()
  rename_expect_error(source, "gate", "die", [
    "InvalidGeometry", "destination cell name already exists",
  ])
  rename_expect_error(source, "absent", "fresh", ["MissingCell", "absent"])
  let bytes = rename_fixture(1)
  let pending = @gdsii.GdsLibrary::parse(bytes).unwrap()
  rename_expect_error(pending, "gate", "coreA", [
    "InvalidGeometry", "destination name is already an unresolved reference target",
  ])
  let allowed = pending.rename_cell("gate", "fresh").unwrap()
  assert_eq(allowed.to_bytes(), rename_fixture(5))
  assert_eq(allowed.catalog().missing_references.length(), 1)
  assert_eq(allowed.catalog().missing_references[0].target, "coreA")
  assert_eq(pending.to_bytes(), bytes)
}

///|
test "cell rename updates a self reference without repairing the cycle" {
  let bytes = rename_fixture(2)
  let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
  let renamed = source.rename_cell("gate", "coreA").unwrap()
  assert_eq(renamed.to_bytes(), rename_fixture(6))
  assert_eq(renamed.hierarchy("coreA").unwrap().cycle, ["coreA", "coreA"])
  assert_eq(renamed.catalog().missing_references.length(), 0)
  assert_eq(source.to_bytes(), bytes)
}

///|
test "cell rename uses existing name profile without a 32-character restriction" {
  let source = @gdsii.GdsLibrary::parse(rename_fixture(0)).unwrap()
  assert_eq(
    source
    .rename_cell("gate", "project_block_name_longer_than_thirty_two_chars")
    .unwrap()
    .to_bytes(),
    rename_fixture(7),
  )
  assert_eq(
    source.rename_cell("probe", "probe 2").unwrap().to_bytes(),
    rename_fixture(8),
  )
}

///|
test "cell rename delegates invalid names to existing checked records" {
  let bytes = rename_fixture(0)
  let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
  rename_expect_error(source, "gate", "", [
    "InvalidStructure", 106, "empty or duplicate cell name",
  ])
  rename_expect_error(source, "gate", "λ", [
    "InvalidRecord", 106, "invalid ASCII",
  ])
  let nul = @utf8.decode(b"x\x00y")
  rename_expect_error(source, "gate", nul, [
    "InvalidRecord", 106, "invalid ASCII",
  ])
  rename_expect_error(source, "gate", "X".repeat(65531), [
    "InvalidRecord", 106, "record cannot be serialized",
  ])
  assert_eq(source.to_bytes(), bytes)
}
