  let flat = lib.flatten_cell("top", budget=15).unwrap()
  assert_eq(flat.shapes.length(), 6)
  {
    let actual = flat.shapes[0].points.map(fn(p) { (p.x, p.y) })
    let expected : Array[(Int, Int)] = [
      (-20, 20),
      (-16, 20),
      (-16, 16),
      (-20, 16),
      (-20, 20),
    ]
    assert_eq(actual, expected)
    assert_eq(
      flat.shapes[0].source,
      "/top:0[0,0]/outer:0[0,0]/mid:0[0,0]/leaf:0",
    )
  }
  {
    let actual = flat.shapes[1].points.map(fn(p) { (p.x, p.y) })
    let expected : Array[(Int, Int)] = [
      (-16, 36),
      (-12, 36),
      (-12, 32),
      (-16, 32),
      (-16, 36),
    ]
    assert_eq(actual, expected)
    assert_eq(
      flat.shapes[1].source,
      "/top:0[0,0]/outer:0[0,0]/mid:0[1,0]/leaf:0",
    )
  }
  {
    let actual = flat.shapes[2].points.map(fn(p) { (p.x, p.y) })
    let expected : Array[(Int, Int)] = [
      (-12, 52),
      (-8, 52),
      (-8, 48),
      (-12, 48),
      (-12, 52),
    ]
    assert_eq(actual, expected)
    assert_eq(
      flat.shapes[2].source,
      "/top:0[0,0]/outer:0[0,0]/mid:0[2,0]/leaf:0",
    )
  }
  {
    let actual = flat.shapes[3].points.map(fn(p) { (p.x, p.y) })
    let expected : Array[(Int, Int)] = [
      (4, 14),
      (8, 14),
      (8, 10),
      (4, 10),
      (4, 14),
    ]
    assert_eq(actual, expected)
    assert_eq(
      flat.shapes[3].source,
      "/top:0[0,0]/outer:0[0,0]/mid:0[0,1]/leaf:0",
    )
  }
  {
    let actual = flat.shapes[4].points.map(fn(p) { (p.x, p.y) })
    let expected : Array[(Int, Int)] = [
      (8, 30),
      (12, 30),
      (12, 26),
      (8, 26),
      (8, 30),
    ]
    assert_eq(actual, expected)
    assert_eq(
      flat.shapes[4].source,
      "/top:0[0,0]/outer:0[0,0]/mid:0[1,1]/leaf:0",
    )
  }
  {
    let actual = flat.shapes[5].points.map(fn(p) { (p.x, p.y) })
    let expected : Array[(Int, Int)] = [
      (12, 46),
      (16, 46),
      (16, 42),
      (12, 42),
      (12, 46),
    ]
    assert_eq(actual, expected)
    assert_eq(
      flat.shapes[5].source,
      "/top:0[0,0]/outer:0[0,0]/mid:0[2,1]/leaf:0",
    )
  }
  assert_true(
    lib.flatten_cell("top", budget=14) is Err(@gdsii.ExpansionLimit(14)),
  )
}

