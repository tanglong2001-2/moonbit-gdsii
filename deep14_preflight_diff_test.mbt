///|
fn deep14_has_issue(
  issues : Array[@gdsii.PreflightIssue],
  wanted : @gdsii.PreflightIssue,
) -> Bool {
  for issue in issues {
    if issue.to_json() == wanted.to_json() {
      return true
    }
  }
  false
}

