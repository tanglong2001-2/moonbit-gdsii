///|
test "deep14 invalid issue-arity" {
  let before = deep14_before_0().preflight_cell("top", 7, 2, 3, 3).unwrap()
  let issue = before.issues[0]
  let bad_issue : @gdsii.PreflightIssue = {
    rule: issue.rule,
    rectangles: [],
    required: issue.required,
    measured: issue.measured,
    shortfall: issue.shortfall,
  }
  let bad : @gdsii.PreflightReport = {
    cell: before.cell,
    layer: before.layer,
    datatype: before.datatype,
    min_width: before.min_width,
    min_spacing: before.min_spacing,
    dbu_in_meters: before.dbu_in_meters,
    status: before.status,
    selected_shapes: before.selected_shapes,
    checked_rectangles: before.checked_rectangles,
    skipped: before.skipped,
    issues: [bad_issue],
    candidates: before.candidates,
    index_visits: before.index_visits,
  }
  assert_true(before.diff(bad) is Err(@gdsii.InvalidGeometry(_)))
  assert_true(bad.diff(before) is Err(@gdsii.InvalidGeometry(_)))
}

///|
test "deep14 invalid issue-threshold" {
  let before = deep14_before_0().preflight_cell("top", 7, 2, 3, 3).unwrap()
  let issue = before.issues[0]
  let bad_issue : @gdsii.PreflightIssue = {
    rule: issue.rule,
    rectangles: issue.rectangles,
    required: issue.required + 1,
    measured: issue.measured,
    shortfall: issue.shortfall,
  }
  let bad : @gdsii.PreflightReport = {
    cell: before.cell,
    layer: before.layer,
    datatype: before.datatype,
    min_width: before.min_width,
    min_spacing: before.min_spacing,
    dbu_in_meters: before.dbu_in_meters,
    status: before.status,
    selected_shapes: before.selected_shapes,
    checked_rectangles: before.checked_rectangles,
    skipped: before.skipped,
    issues: [bad_issue],
    candidates: before.candidates,
    index_visits: before.index_visits,
  }
  assert_true(before.diff(bad) is Err(@gdsii.InvalidGeometry(_)))
  assert_true(bad.diff(before) is Err(@gdsii.InvalidGeometry(_)))
}

///|
test "deep14 diagnostic floating values are not identity" {
  let before = deep14_before_15().preflight_cell("top", 7, 2, 0, 5).unwrap()
  let issue = before.issues[0]
  let rounded : @gdsii.PreflightIssue = {
    rule: issue.rule,
    rectangles: issue.rectangles.copy(),
    required: issue.required,
    measured: issue.measured + 1.0e-15,
    shortfall: issue.shortfall + 1.0e-15,
  }
  let after : @gdsii.PreflightReport = {
    cell: before.cell,
    layer: before.layer,
    datatype: before.datatype,
    min_width: before.min_width,
    min_spacing: before.min_spacing,
    dbu_in_meters: before.dbu_in_meters,
    status: before.status,
    selected_shapes: before.selected_shapes,
    checked_rectangles: before.checked_rectangles,
    skipped: before.skipped,
    issues: [rounded],
    candidates: before.candidates,
    index_visits: before.index_visits,
  }
  let diff = before.diff(after).unwrap()
  assert_eq(diff.retained, 1)
  assert_eq(diff.introduced.length(), 0)
  assert_eq(diff.removed.length(), 0)
}

///|
test "deep14 difference arrays cannot mutate either input report" {
  let before = deep14_before_8().preflight_cell("top", 7, 2, 3, 0).unwrap()
  let after = deep14_after_8().preflight_cell("top", 7, 2, 3, 0).unwrap()
  let before_json = before.to_json()
  let after_json = after.to_json()
  let diff = before.diff(after).unwrap()
  diff.removed[0].rectangles.clear()
  diff.removed.clear()
  diff.after_skipped.clear()
  let inverse = after.diff(before).unwrap()
  inverse.introduced[0].rectangles.clear()
  inverse.introduced.clear()
  inverse.before_skipped.clear()
  assert_eq(before.to_json(), before_json)
  assert_eq(after.to_json(), after_json)
}
