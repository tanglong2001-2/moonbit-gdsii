///|
test "deep14 unit-profile-mismatch" {
  let before_lib = deep14_before_16()
  let after_lib = deep14_after_16()
  let before_raw = before_lib.to_bytes()
  let after_raw = after_lib.to_bytes()
  let before = before_lib.preflight_cell("top", 7, 2, 3, 3).unwrap()
  let after = after_lib.preflight_cell("top", 7, 2, 3, 3).unwrap()
  assert_true(before.diff(after) is Err(@gdsii.InvalidGeometry(_)))
  assert_eq(before_lib.to_bytes(), before_raw)
  assert_eq(after_lib.to_bytes(), after_raw)
}

///|
test "deep14 incompatible cell" {
  let before = deep14_before_0().preflight_cell("top", 7, 2, 3, 3).unwrap()
  let after : @gdsii.PreflightReport = {
    cell: "other",
    layer: before.layer,
    datatype: before.datatype,
    min_width: before.min_width,
    min_spacing: before.min_spacing,
    dbu_in_meters: before.dbu_in_meters,
    status: before.status,
    selected_shapes: before.selected_shapes,
    checked_rectangles: before.checked_rectangles,
    skipped: before.skipped,
    issues: before.issues,
    candidates: before.candidates,
    index_visits: before.index_visits,
  }
  assert_true(before.diff(after) is Err(@gdsii.InvalidGeometry(_)))
}

