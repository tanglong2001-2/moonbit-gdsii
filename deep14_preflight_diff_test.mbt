///|
test "deep14 repaired" {
  let before_lib = deep14_before_0()
  let after_lib = deep14_after_0()
  let before_raw = before_lib.to_bytes()
  let after_raw = after_lib.to_bytes()
  let before = before_lib.preflight_cell("top", 7, 2, 3, 3).unwrap()
  let after = after_lib.preflight_cell("top", 7, 2, 3, 3).unwrap()
  let difference = before.diff(after).unwrap()
  assert_eq(difference.status.to_json(), "NoNewIssues")
  assert_eq(difference.introduced.length(), 0)
  assert_eq(difference.removed.length(), 2)
  assert_eq(difference.retained, 0)
  assert_eq(difference.before_checked_rectangles, 2)
  assert_eq(difference.after_checked_rectangles, 2)
  assert_eq(difference.before_skipped.length(), 0)
  assert_eq(difference.after_skipped.length(), 0)
  for issue in difference.introduced {
    assert_true(deep14_has_issue(after.issues, issue))
  }
  for issue in difference.removed {
    assert_true(deep14_has_issue(before.issues, issue))
  }
  assert_eq(before_lib.to_bytes(), before_raw)
  assert_eq(after_lib.to_bytes(), after_raw)
}

