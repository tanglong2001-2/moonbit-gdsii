///|
test "reverse impact covers shared callers, array edge metadata and shortest direct path" {
  let lib = impact_library(false)
  let impact = lib.reference_impact("leaf")
  assert_eq(impact.target, "leaf")
  assert_eq(impact.target_defined, true)
  assert_eq(impact.cells.map(fn(c) { c.name }), [
    "leaf", "mid", "right", "top", "cycleA", "cycleB",
  ])
  assert_eq(impact.cells.map(fn(c) { c.is_top }), [
    false, false, false, true, false, false,
  ])
  assert_eq(impact.cells.map(fn(c) { c.witness.length() }), [0, 1, 1, 1, 2, 1])
  let array = impact.cells[2].witness[0]
  assert_eq(array.cell, "right")
  assert_eq(array.kind, @gdsii.Aref)
  assert_eq((array.columns, array.rows, array.instances), (1, 2, 2))
  assert_eq(array.resolved, true)
  assert_eq(impact.cells[3].witness[0].element_index, 2)
  assert_eq(impact.cells[4].witness.map(fn(r) { (r.cell, r.target) }), [
    ("cycleA", "cycleB"),
    ("cycleB", "leaf"),
  ])
}

///|
test "equal shortest witnesses use first reverse discovery rather than a longer walk" {
  let impact = impact_library(true).reference_impact("leaf")
  assert_eq(
    impact.cells[3].witness.map(fn(r) { (r.cell, r.element_index, r.target) }),
    [("top", 0, "mid"), ("mid", 0, "leaf")],
  )
}

///|
test "undefined targets retain known callers without inventing definitions or trimming names" {
  let lib = impact_library(false)
  let ghost = lib.reference_impact("ghost")
  assert_eq(ghost.target_defined, false)
  assert_eq(ghost.cells.map(fn(c) { c.name }), ["waiting"])
  assert_eq(ghost.cells[0].is_top, true)
  assert_eq(ghost.cells[0].witness[0].resolved, false)
  assert_eq(ghost.cells[0].witness[0].target, "ghost")
  assert_eq(lib.reference_impact("nobody").cells.length(), 0)
  assert_eq(lib.reference_impact("leaf ").target_defined, false)
  assert_eq(lib.reference_impact("leaf ").cells.length(), 0)
}

///|
test "rootless cycle and ancestor query do not require tops or include descendants" {
  let lib = impact_library(false)
  let cycle = lib.reference_impact("cycleA")
  assert_eq(cycle.cells.map(fn(c) { (c.name, c.is_top, c.witness.length()) }), [
    ("cycleA", false, 0),
    ("cycleB", false, 1),
  ])
  assert_eq(cycle.cells[1].witness[0].target, "cycleA")
  assert_eq(lib.reference_impact("mid").cells.map(fn(c) { c.name }), [
    "mid", "top",
  ])
  let spare = lib.reference_impact("spare")
  assert_eq(spare.cells.map(fn(c) { (c.name, c.is_top, c.witness.length()) }), [
    ("spare", true, 0),
  ])
}

///|
test "impact witness and cell arrays cannot mutate source or another query" {
  let lib = impact_library(false)
  let original = lib.to_bytes()
  let first = lib.reference_impact("leaf")
  first.cells[1].witness.clear()
  first.cells.clear()
  let second = lib.reference_impact("leaf")
  assert_eq(second.cells.length(), 6)
  assert_eq(second.cells[1].witness.length(), 1)
  assert_eq(lib.to_bytes(), original)
}
