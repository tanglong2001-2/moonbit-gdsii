    0x10, 0x03, 0xff, 0xff, 0xff, 0xfd, 0x00, 0x00, 0x00, 0x05, 0x00, 0x04, 0x11,
    0x00, 0x00, 0x04, 0x07, 0x00, 0x00, 0x1c, 0x05, 0x02, 0x00, 0x7e, 0x00, 0x0a,
    0x00, 0x1c, 0x00, 0x02, 0x00, 0x04, 0x00, 0x27, 0x00, 0x7e, 0x00, 0x0a, 0x00,
    0x1c, 0x00, 0x02, 0x00, 0x04, 0x00, 0x27, 0x00, 0x08, 0x06, 0x06, 0x74, 0x6f,
    0x70, 0x00, 0x00, 0x04, 0x0a, 0x00, 0x00, 0x08, 0x12, 0x06, 0x6d, 0x69, 0x64,
    0x00, 0x00, 0x06, 0x1a, 0x01, 0x00, 0x00, 0x00, 0x0c, 0x1b, 0x05, 0x41, 0x30,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0c, 0x1c, 0x05, 0x42, 0x5a, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0c, 0x10, 0x03, 0x00, 0x00, 0x00, 0x0a,
    0xff, 0xff, 0xff, 0xfc, 0x00, 0x04, 0x11, 0x00, 0x00, 0x04, 0x07, 0x00, 0x00,
    0x04, 0x04, 0x00,
  ]
  let lib = @gdsii.GdsLibrary::parse(bytes).unwrap()
  assert_eq(lib.to_bytes(), bytes)
  let flat = lib.flatten_cell("top").unwrap()
  let actual = normalized_polygons(flat)
  let expected : Array[Array[(Int, Int)]] = [
    [(-8, -19), (-8, -7), (-2, -7), (-2, -19)],
  ]
  assert_eq(actual, expected)
  for shape in flat.shapes {
    assert_eq(shape.layer, 7)
    assert_eq(shape.datatype, 2)
  }
}
