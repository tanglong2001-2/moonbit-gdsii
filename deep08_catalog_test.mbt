    b"\x00\x06\x00\x02\x02\x58\x00\x1c\x01\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x02\x06\x43\x41\x54\x38\x00\x14\x03\x05\x40\x20\x00\x00\x00\x00\x00\x00\x39\x40\x00\x00\x00\x00\x00\x00\x00\x1c\x05\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x06\x06\x74\x6f\x70\x00\x00\x04\x0b\x00\x00\x08\x12\x06\x6c\x65\x61\x66\x00\x08\x13\x02\x7f\xff\x7f\xff\x00\x1c\x10\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x14\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1e\x00\x04\x11\x00\x00\x04\x07\x00\x00\x1c\x05\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x06\x06\x6c\x65\x61\x66\x00\x04\x15\x00\x00\x06\x0d\x02\x00\x07\x00\x06\x2a\x02\x00\x02\x00\x0c\x10\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x11\x00\x00\x04\x07\x00\x00\x04\x04\x00\x00\x00\x00\x00\x00\x00",
  ).unwrap()
  let before = lib.to_bytes()
  let expected : Json = {
    "name": "CAT8",
    "version": 600,
    "dbu_in_user_units": 0.125,
    "dbu_in_meters": 9.313225746154785e-10,
    "cells": [
      {
        "name": "top",
        "elements": 1,
        "layers": [],
        "references": [
          {
            "cell": "top",
            "element_index": 0,
            "kind": "Aref",
            "target": "leaf",
            "columns": 32767,
            "rows": 32767,
            "instances": 1073676289,
            "resolved": true,
          },
        ],
      },
      {
        "name": "leaf",
        "elements": 1,
        "layers": [{ "kind": "Node", "layer": 7, "datatype": 2, "elements": 1 }],
        "references": [],
      },
    ],
    "top_cells": ["top"],
    "missing_references": [],
  }
  assert_eq(lib.catalog().to_json(), expected)
  assert_eq(lib.to_bytes(), before)
}

///|
test "deep08 catalog arrays cannot mutate the library" {
  let lib = deep08_catalog_mixed()
  let expected = lib.catalog().to_json()
  let report = lib.catalog()
  report.cells[0].layers[0] = {
    kind: @gdsii.Path,
    layer: 1,
    datatype: 1,
    elements: 99,
  }
  report.cells[1].references.clear()
  report.top_cells.clear()
  report.missing_references.push({
    cell: "fake",
    element_index: 0,
    kind: @gdsii.Sref,
    target: "fake",
    columns: 1,
    rows: 1,
    instances: 1,
    resolved: false,
  })
  assert_eq(lib.catalog().to_json(), expected)
}
