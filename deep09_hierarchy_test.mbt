test "deep09 diamond-isolates-unreachable-problems" {
  let lib = @gdsii.GdsLibrary::parse(deep09_input_0()).unwrap()
  let before = lib.to_bytes()
  let expected : Json = {
    "cell": "top",
    "reachable_cells": ["leaf", "left", "right", "top"],
    "layers": [
      { "kind": "Boundary", "layer": 7, "datatype": 2, "elements": 2 },
      { "kind": "Path", "layer": 7, "datatype": 2, "elements": 1 },
      { "kind": "Text", "layer": 7, "datatype": 2, "elements": 1 },
      { "kind": "Node", "layer": 7, "datatype": 2, "elements": 1 },
      { "kind": "Box", "layer": 7, "datatype": 2, "elements": 1 },
    ],
    "references": [
      {
        "cell": "left",
        "element_index": 0,
        "kind": "Sref",
        "target": "leaf",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
      {
        "cell": "right",
        "element_index": 0,
        "kind": "Sref",
        "target": "leaf",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
      {
        "cell": "top",
        "element_index": 0,
        "kind": "Sref",
        "target": "left",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
      {
        "cell": "top",
        "element_index": 1,
        "kind": "Sref",
        "target": "right",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
    ],
    "missing_references": [],
    "cycle": [],
  }
  assert_eq(lib.hierarchy("top").unwrap().to_json(), expected)
  assert_eq(lib.to_bytes(), before)
}

