///|
test "deep09 first-of-two-cycles" {
  let lib = @gdsii.GdsLibrary::parse(deep09_input_9()).unwrap()
  let before = lib.to_bytes()
  let expected : Json = {
    "cell": "top",
    "reachable_cells": ["a", "b", "top"],
    "layers": [
      { "kind": "Node", "layer": 1, "datatype": 0, "elements": 1 },
      { "kind": "Node", "layer": 2, "datatype": 0, "elements": 1 },
    ],
    "references": [
      {
        "cell": "a",
        "element_index": 0,
        "kind": "Sref",
        "target": "a",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
      {
        "cell": "b",
        "element_index": 0,
        "kind": "Sref",
        "target": "b",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
      {
        "cell": "top",
        "element_index": 0,
        "kind": "Sref",
        "target": "a",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
      {
        "cell": "top",
        "element_index": 1,
        "kind": "Sref",
        "target": "b",
        "columns": 1,
        "rows": 1,
        "instances": 1,
        "resolved": true,
      },
    ],
    "missing_references": [],
    "cycle": ["a", "a"],
  }
  assert_eq(lib.hierarchy("top").unwrap().to_json(), expected)
  assert_eq(lib.to_bytes(), before)
}

///|
test "deep09 missing selected cell" {
  let lib = @gdsii.GdsLibrary::parse(deep09_input_0()).unwrap()
  assert_true(lib.hierarchy("absent") is Err(@gdsii.MissingCell("absent")))
}

///|
test "deep09 missing root in empty library" {
  let lib = @gdsii.GdsLibrary::parse(
    b"\x00\x06\x00\x02\x02\x58\x00\x1c\x01\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x02\x06\x52\x30\x39\x58\x00\x14\x03\x05\x41\x10\x00\x00\x00\x00\x00\x00\x41\x10\x00\x00\x00\x00\x00\x00\x00\x04\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  ).unwrap()
  assert_true(lib.hierarchy("top") is Err(@gdsii.MissingCell("top")))
}

///|
test "deep09 report arrays cannot mutate later reports or the library" {
  let lib = @gdsii.GdsLibrary::parse(deep09_input_0()).unwrap()
  let before = lib.to_bytes()
  let expected = lib.hierarchy("top").unwrap().to_json()
  let report = lib.hierarchy("top").unwrap()
  report.layers.clear()
  report.reachable_cells.clear()
  report.references.clear()
  report.missing_references.push({
    cell: "fake",
    element_index: 0,
    kind: @gdsii.Sref,
    target: "fake",
    columns: 1,
    rows: 1,
    instances: 1,
    resolved: false,
  })
  report.cycle.push("fake")
  assert_eq(lib.hierarchy("top").unwrap().to_json(), expected)
  assert_eq(lib.to_bytes(), before)
}
