///|
fn deep09_input_8() -> Bytes {
  let buffer = @buffer.Buffer()

  for
    part in [
      b"\x00\x06\x00\x02\x02\x58\x00\x1c\x01\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x02\x06\x52\x30\x39\x58\x00\x14\x03\x05\x41\x10\x00\x00\x00\x00\x00\x00\x41\x10\x00\x00\x00\x00\x00\x00\x00\x1c\x05\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0a\x06\x06\x65\x6d\x70\x74\x79\x00\x00\x04\x07\x00\x00\x04\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    ] {
    buffer.write_bytes(part)
  }

  buffer.to_bytes()
}

///|
test "deep09 empty-cell" {
  let lib = @gdsii.GdsLibrary::parse(deep09_input_8()).unwrap()
  let before = lib.to_bytes()
  let expected : Json = {
    "cell": "empty",
    "reachable_cells": ["empty"],
    "layers": [],
    "references": [],
    "missing_references": [],
    "cycle": [],
  }
  assert_eq(lib.hierarchy("empty").unwrap().to_json(), expected)
  assert_eq(lib.to_bytes(), before)
}

