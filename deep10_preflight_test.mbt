///|
test "deep10 negative rules are request errors" {
  let lib = @gdsii.GdsLibrary::parse(deep10_input_0()).unwrap()
  for values in [(-1, 0), (0, -1)] {
    assert_true(
      lib.preflight_cell("top", 7, 2, values.0, values.1)
      is Err(@gdsii.InvalidGeometry(_)),
    )
  }
}

///|
test "deep10 negative selectors are request errors" {
  let lib = @gdsii.GdsLibrary::parse(deep10_input_0()).unwrap()
  for values in [(-1, 2), (7, -1)] {
    assert_true(
      lib.preflight_cell("top", values.0, values.1, 0, 0)
      is Err(@gdsii.InvalidGeometry(_)),
    )
  }
}

///|
test "deep10 expansion budget errors propagate" {
  let lib = @gdsii.GdsLibrary::parse(deep10_input_0()).unwrap()
  for budget in [0, 1] {
    assert_true(
      lib.preflight_cell("top", 7, 2, 0, 0, budget~)
      is Err(@gdsii.ExpansionLimit(_)),
    )
  }
}

///|
test "deep10 missing selected cell errors propagate" {
  let lib = @gdsii.GdsLibrary::parse(deep10_input_0()).unwrap()
  assert_true(
    lib.preflight_cell("absent", 7, 2, 0, 0)
    is Err(@gdsii.MissingCell("absent")),
  )
}

///|
test "deep10 mutable report arrays leave source and later reports intact" {
  let lib = @gdsii.GdsLibrary::parse(deep10_input_1()).unwrap()
  let before = lib.to_bytes()
  let expected = lib.preflight_cell("top", 7, 2, 3, 3).unwrap().to_json()
  let report = lib.preflight_cell("top", 7, 2, 3, 3).unwrap()
  report.issues[0].rectangles.clear()
  report.issues.clear()
  report.skipped.clear()
  assert_eq(lib.preflight_cell("top", 7, 2, 3, 3).unwrap().to_json(), expected)
  assert_eq(lib.to_bytes(), before)
}
