  )
  assert_true(
    (issue.shortfall - 0x3df0004000a00100UL.reinterpret_as_double()).abs() <=
    0x3df0004000a00100UL.reinterpret_as_double().abs() * 1.0e-13,
  )
  assert_true(issue.shortfall > 0.0)
  assert_eq(lib.to_bytes(), before)
}

