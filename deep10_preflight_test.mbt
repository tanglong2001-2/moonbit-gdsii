///|
test "deep10 partial-with-violation" {
  let lib = @gdsii.GdsLibrary::parse(deep10_input_7()).unwrap()
  let before = lib.to_bytes()
  let report = lib.preflight_cell("top", 7, 2, 3, 0).unwrap()
  assert_eq(report.status.to_json(), "ViolationsFound")
  assert_eq(report.cell, "top")
  assert_eq(report.layer, 7)
  assert_eq(report.datatype, 2)
  assert_eq(report.min_width, 3)
  assert_eq(report.min_spacing, 0)
  assert_eq(report.dbu_in_meters, 0x3e10000000000000UL.reinterpret_as_double())
  assert_eq(report.selected_shapes, 2)
  assert_eq(report.checked_rectangles, 1)
  assert_eq(report.skipped.length(), 1)
  assert_eq(report.issues.length(), 1)
  assert_eq(report.skipped[0].source, "/top:1")
  let issue = report.issues[0]
  assert_eq(issue.rule.to_json(), "Width")
  assert_eq(issue.required, 3)
  let expected_rectangles : Array[@gdsii.Rect] = [
    { min_x: 0, min_y: 0, max_x: 2, max_y: 6, source: "/top:0", },
  ]
  assert_eq(issue.rectangles, expected_rectangles)
  assert_true(
    (issue.measured - 0x4000000000000000UL.reinterpret_as_double()).abs() <=
    0x4000000000000000UL.reinterpret_as_double().abs() * 1.0e-13,
  )
  assert_true(
    (issue.shortfall - 0x3ff0000000000000UL.reinterpret_as_double()).abs() <=
    0x3ff0000000000000UL.reinterpret_as_double().abs() * 1.0e-13,
  )
  assert_true(issue.shortfall > 0.0)
  assert_eq(lib.to_bytes(), before)
}

