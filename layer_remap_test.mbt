///|
test "layer remap changes all five tag kinds and only named payloads" {
  let original = layer_remap_fixture(0)
  let lib = @gdsii.GdsLibrary::parse(original).unwrap()
  let output = lib
    .remap_layers([{ from_layer: 1, from_type: 2, to_layer: 7, to_type: 8, }])
    .unwrap()
  assert_eq(output.to_bytes(), layer_remap_fixture(1))
  assert_eq(lib.to_bytes(), original)
}

///|
test "layer remap swap chain and merge use original pairs" {
  {
    let original = layer_remap_fixture(0)
    let lib = @gdsii.GdsLibrary::parse(original).unwrap()
    let output = lib
      .remap_layers([
        { from_layer: 1, from_type: 2, to_layer: 3, to_type: 4, },
        { from_layer: 3, from_type: 4, to_layer: 1, to_type: 2, },
      ])
      .unwrap()
    assert_eq(output.to_bytes(), layer_remap_fixture(2))
    assert_eq(lib.to_bytes(), original)
  }
  {
    let original = layer_remap_fixture(0)
    let lib = @gdsii.GdsLibrary::parse(original).unwrap()
    let output = lib
      .remap_layers([
        { from_layer: 1, from_type: 2, to_layer: 3, to_type: 4, },
        { from_layer: 3, from_type: 4, to_layer: 9, to_type: 10, },
      ])
      .unwrap()
    assert_eq(output.to_bytes(), layer_remap_fixture(3))
    assert_eq(lib.to_bytes(), original)
  }
  let original = layer_remap_fixture(0)
  let lib = @gdsii.GdsLibrary::parse(original).unwrap()
  let output = lib
    .remap_layers([
      { from_layer: 1, from_type: 2, to_layer: 3, to_type: 4, },
      { from_layer: 9, from_type: 10, to_layer: 3, to_type: 4, },
    ])
    .unwrap()
  assert_eq(output.to_bytes(), layer_remap_fixture(4))
  assert_eq(lib.to_bytes(), original)
}

///|
test "layer remap keeps full UINT16 range" {
  let original = layer_remap_fixture(0)
  let lib = @gdsii.GdsLibrary::parse(original).unwrap()
  let output = lib
    .remap_layers([
      { from_layer: 0, from_type: 65535, to_layer: 65535, to_type: 0, },
      { from_layer: 65535, from_type: 0, to_layer: 0, to_type: 65535, },
    ])
    .unwrap()
  assert_eq(output.to_bytes(), layer_remap_fixture(5))
  assert_eq(lib.to_bytes(), original)
}

///|
test "layer remap identity unmatched empty map and empty library preserve stream" {
  {
    let original = layer_remap_fixture(0)
    let lib = @gdsii.GdsLibrary::parse(original).unwrap()
    let output = lib
      .remap_layers([
        { from_layer: 1, from_type: 2, to_layer: 1, to_type: 2, },
        { from_layer: 60000, from_type: 65535, to_layer: 8, to_type: 9, },
      ])
      .unwrap()
    assert_eq(output.to_bytes(), layer_remap_fixture(0))
    assert_eq(lib.to_bytes(), original)
  }
  {
    let original = layer_remap_fixture(0)
    let lib = @gdsii.GdsLibrary::parse(original).unwrap()
    let output = lib.remap_layers([]).unwrap()
    assert_eq(output.to_bytes(), layer_remap_fixture(0))
    assert_eq(lib.to_bytes(), original)
  }
  let original = layer_remap_fixture(6)
  let lib = @gdsii.GdsLibrary::parse(original).unwrap()
  let output = lib
    .remap_layers([{ from_layer: 1, from_type: 2, to_layer: 7, to_type: 8, }])
    .unwrap()
  assert_eq(output.to_bytes(), layer_remap_fixture(6))
  assert_eq(lib.to_bytes(), original)
}

///|
test "layer remap validates all fields and duplicate unused sources atomically" {
  let original = layer_remap_fixture(0)
  let lib = @gdsii.GdsLibrary::parse(original).unwrap()
  let valid : @gdsii.LayerRemap = {
    from_layer: 1,
    from_type: 2,
    to_layer: 7,
    to_type: 8,
  }
  let invalid : Array[@gdsii.LayerRemap] = [
    { from_layer: -1, from_type: 60001, to_layer: 60002, to_type: 60003, },
    { from_layer: 65536, from_type: 60001, to_layer: 60002, to_type: 60003, },
    { from_layer: 60000, from_type: -1, to_layer: 60002, to_type: 60003, },
    { from_layer: 60000, from_type: 65536, to_layer: 60002, to_type: 60003, },
    { from_layer: 60000, from_type: 60001, to_layer: -1, to_type: 60003, },
    { from_layer: 60000, from_type: 60001, to_layer: 65536, to_type: 60003, },
    { from_layer: 60000, from_type: 60001, to_layer: 60002, to_type: -1, },
    { from_layer: 60000, from_type: 60001, to_layer: 60002, to_type: 65536, },
  ]
  for invalid_rule in invalid {
    guard lib.remap_layers([valid, invalid_rule])
      is Err(@gdsii.InvalidNumber(_)) else {
      fail("every invalid UINT16 field must reject even an unmatched last rule")
    }
    assert_eq(lib.to_bytes(), original)
  }
  let unused : @gdsii.LayerRemap = {
    from_layer: 60000,
    from_type: 60001,
    to_layer: 7,
    to_type: 8,
  }
  guard lib.remap_layers([valid, unused, unused])
    is Err(@gdsii.InvalidGeometry(_)) else {
    fail("duplicate unmatched source must reject even identical destinations")
  }
  assert_eq(lib.to_bytes(), original)
}

///|
test "layer remap preserves references and owns independent parsed arrays" {
  let original = layer_remap_fixture(0)
  let lib = @gdsii.GdsLibrary::parse(original).unwrap()
  let mappings : Array[@gdsii.LayerRemap] = [
    { from_layer: 1, from_type: 2, to_layer: 7, to_type: 8, },
  ]
  let output = lib.remap_layers(mappings).unwrap()
  mappings.clear()
  let cells = output.cells()
  assert_eq(cells[0].elements[0].layer, 7)
  assert_eq(cells[0].elements[0].datatype, 8)
  assert_eq(cells[0].elements[5].target, "ghost")
  assert_eq(cells[0].elements[6].target, "core")
  assert_eq(cells[0].elements[6].columns, 2)
  assert_eq(cells[0].elements[6].rows, 3)
  cells[0].elements.clear()
  cells.clear()
  assert_eq(output.cells()[0].elements.length(), 7)
  assert_eq(output.to_bytes(), layer_remap_fixture(1))
  assert_eq(lib.to_bytes(), original)
  assert_eq(lib.cells()[0].elements[0].layer, 1)
}
