///|
test "cell extraction complete independent stream and offsets" {
  let original = extraction_fixture(0)
  let source = @gdsii.GdsLibrary::parse(original).unwrap()
  let result = source.extract_cell("top").unwrap()
  assert_eq(result.to_bytes(), extraction_fixture(6))
  assert_eq(source.to_bytes(), original)
  assert_eq([ for c in result.catalog().cells => c.name ], ["leaf", "top"])
  assert_eq(result.catalog().top_cells, ["top"])
  let receiver = @gdsii.GdsLibrary::parse(result.to_bytes()).unwrap()
  assert_eq(receiver.hierarchy("top").unwrap().reachable_cells, ["leaf", "top"])
  let mut offset = 0
  for record in result.records() {
    assert_eq(record.offset, offset)
    offset += record.data.length() + 4
  }
  assert_eq(offset, result.to_bytes().length())
  let (user, meters) = result.units()
  assert_eq(user.to_bytes(), b"\x41\x10\x00\x00\x00\x00\x00\x00")
  assert_eq(meters.to_bytes(), b"\x41\x10\x00\x00\x00\x00\x00\x01")
}

///|
test "cell extraction shared dependency ignores outside graph problems" {
  for index in [0, 1, 2] {
    let bytes = extraction_fixture(index)
    let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
    assert_eq(
      source.extract_cell("top").unwrap().to_bytes(),
      extraction_fixture(6),
    )
    assert_eq(source.to_bytes(), bytes)
  }
}

///|
test "cell extraction child and empty definitions" {
  let source = @gdsii.GdsLibrary::parse(extraction_fixture(0)).unwrap()
  let child = source.extract_cell("leaf").unwrap()
  assert_eq(child.to_bytes(), extraction_fixture(7))
  assert_eq([ for c in child.catalog().cells => c.name ], ["leaf"])
  let empty = @gdsii.GdsLibrary::parse(extraction_fixture(5))
    .unwrap()
    .extract_cell("empty")
    .unwrap()
  assert_eq(empty.to_bytes(), extraction_fixture(9))
  assert_eq(empty.catalog().top_cells, ["empty"])
}

///|
test "cell extraction reachable missing target and selected name errors" {
  let bytes = extraction_fixture(3)
  let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
  assert_eq(
    source.hierarchy("top").unwrap().missing_references[0].target,
    "ghost",
  )
  match source.extract_cell("top") {
    Ok(_) => fail("reachable missing dependency must prevent a closed export")
    Err(error) => assert_eq(error.to_json(), ["MissingCell", "ghost"])
  }
  match source.extract_cell("not-found") {
    Ok(_) => fail("missing selected cell must fail")
    Err(error) => assert_eq(error.to_json(), ["MissingCell", "not-found"])
  }
  assert_eq(source.to_bytes(), bytes)
}

///|
test "cell extraction preserves closed cycle as unexpanded valid data" {
  let bytes = extraction_fixture(4)
  let source = @gdsii.GdsLibrary::parse(bytes).unwrap()
  let result = source.extract_cell("A").unwrap()
  assert_eq(result.to_bytes(), extraction_fixture(8))
  let receiver = @gdsii.GdsLibrary::parse(result.to_bytes()).unwrap()
  assert_eq([ for c in receiver.catalog().cells => c.name ], ["A", "B"])
  assert_eq(receiver.catalog().top_cells, [])
  assert_eq(receiver.hierarchy("A").unwrap().cycle, ["A", "B", "A"])
  match receiver.flatten_cell("A") {
    Ok(_) => fail("extraction must not flatten or repair a cycle")
    Err(error) =>
      assert_eq(error.to_json(), ["CyclicReference", ["A", "B", "A"]])
  }
  assert_eq(source.to_bytes(), bytes)
}
