///|
test "growing earlier records shifts offsets without changing later definitions" {
  let diff = definition_library(0).definition_diff(definition_library(1))
  assert_eq(diff.before_cells, ["alpha", "beta", "gamma"])
  assert_eq(diff.after_cells, diff.before_cells)
  assert_eq(diff.cells.map(fn(c) { c.status }), [
    @gdsii.DefinitionChanged,
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionUnchanged,
  ])
  assert_eq(diff.first_difference, Some(131))
  assert_eq(diff.library_records_equal, true)
  assert_eq(diff.padding_equal, true)
  let before = diff.cells[1].before.unwrap()
  let after = diff.cells[1].after.unwrap()
  assert_eq(
    (
      before.first_record,
      before.record_count,
      before.byte_offset,
      before.byte_length,
    ),
    (20, 8, 218, 104),
  )
  assert_eq(
    (
      after.first_record,
      after.record_count,
      after.byte_offset,
      after.byte_length,
    ),
    (21, 8, 234, 104),
  )
}

///|
test "union order preserves before names and appends new exact names" {
  let diff = definition_library(0).definition_diff(definition_library(2))
  assert_eq(diff.after_cells, ["beta", "delta", "alpha"])
  assert_eq(diff.cells.map(fn(c) { c.name }), [
    "alpha", "beta", "gamma", "delta",
  ])
  assert_eq(diff.cells.map(fn(c) { c.status }), [
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionRemoved,
    @gdsii.DefinitionAdded,
  ])
  assert_eq(diff.cell_order_equal, false)
  assert_eq(diff.cells[2].after, None)
  assert_eq(diff.cells[3].before, None)
  guard diff.cells[3].to_json() is { "before": Null, "after": Object(_), .. } else {
    fail("wire ranges must be nullable objects")
  }
}

///|
test "physical equality is independent of library views and includes padding" {
  let base = definition_library(0)
  let moved = base.definition_diff(definition_library(3))
  assert_eq(
    (moved.library_records_equal, moved.cell_order_equal, moved.padding_equal),
    (true, true, true),
  )
  assert_eq(moved.cells.map(fn(c) { c.status }), [
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionUnchanged,
  ])
  assert_eq(moved.bytes_equal, false)
  assert_eq(moved.first_difference, Some(69))
  let tail = base.definition_diff(definition_library(4))
  assert_eq(tail.padding_equal, false)
  assert_eq(tail.first_difference, Some(406))
}

///|
test "properties dates and outside records retain strict byte semantics" {
  let base = definition_library(0)
  let property = base.definition_diff(definition_library(6))
  assert_eq(property.cells[0].status, @gdsii.DefinitionChanged)
  assert_eq(property.first_difference, Some(174))
  let dates = base.definition_diff(definition_library(7))
  assert_eq(dates.cells[1].status, @gdsii.DefinitionChanged)
  assert_eq(dates.first_difference, Some(229))
  let library = base.definition_diff(definition_library(8))
  assert_eq(library.library_records_equal, false)
  assert_eq(library.cells.map(fn(c) { c.status }), [
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionUnchanged,
    @gdsii.DefinitionUnchanged,
  ])
}

///|
test "empty valid libraries and missing or cyclic references need no expansion" {
  let empty = definition_library(5)
  let base = definition_library(0) // alpha dangles; gamma references itself.
  let same = empty.definition_diff(empty)
  assert_eq(same.bytes_equal, true)
  assert_eq(same.first_difference, None)
  assert_eq(same.cells.length(), 0)
  guard same.to_json() is { "first_difference": Null, .. } else {
    fail("nullable first offset")
  }
  assert_eq(empty.definition_diff(base).cells.map(fn(c) { c.status }), [
    @gdsii.DefinitionAdded,
    @gdsii.DefinitionAdded,
    @gdsii.DefinitionAdded,
  ])
  assert_eq(base.definition_diff(empty).cells.map(fn(c) { c.status }), [
    @gdsii.DefinitionRemoved,
    @gdsii.DefinitionRemoved,
    @gdsii.DefinitionRemoved,
  ])
}

///|
test "returned arrays cannot change libraries or a subsequent diff" {
  let before = definition_library(0)
  let after = definition_library(1)
  let b = before.to_bytes()
  let a = after.to_bytes()
  let first = before.definition_diff(after)
  first.cells.clear()
  first.before_cells.clear()
  first.after_cells.clear()
  assert_eq(before.definition_diff(after).cells.length(), 3)
  assert_eq(before.to_bytes(), b)
  assert_eq(after.to_bytes(), a)
}
